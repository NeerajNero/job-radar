{
  "name": "jobradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "companies:detect": "node --env-file=.env.local --import tsx scripts/companies-detect.ts",
    "companies:add": "node --env-file=.env.local --import tsx scripts/companies-add.ts",
    "tick:dry": "node --env-file=.env.local --import tsx scripts/tick-dry.ts",
    "tick:local": "node --env-file=.env.local --import tsx scripts/tick-local.ts",
    "reevaluate": "node --env-file=.env.local --import tsx scripts/reevaluate.ts",
    "bot:dev": "node --env-file=.env.local --import tsx scripts/bot-dev.ts",
    "bot:set-webhook": "node --env-file=.env.local --import tsx scripts/bot-set-webhook.ts",
    "bot:webhook-info": "node --env-file=.env.local --import tsx scripts/bot-webhook-info.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
